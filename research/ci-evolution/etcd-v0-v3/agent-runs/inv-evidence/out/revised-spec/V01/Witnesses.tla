C3 == [node |-> 1, voters |-> {1, 2, 3}, config |-> [voters |-> {1, 2, 3}, outgoing |-> {}, learners |-> {}, learnersNext |-> {}, autoLeave |-> FALSE], role |-> "Follower", pre |-> TRUE, term |-> 2, applied |-> 1, commit |-> 2, first |-> 1, hist |-> <<[kind |-> "Normal", term |-> 2, index |-> 1, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "V2", term |-> 2, index |-> 2, changes |-> <<[kind |-> "AddVoter", target |-> 3]>>, transition |-> "Auto", weight |-> 8, encoded |-> 16, target |-> 0, id |-> 0]>>, trigger |-> "Hup", elapsed |-> 0, timeout |-> 10, voteRequests |-> {[term |-> 3, index |-> 2, type |-> "MsgPreVote", to |-> 2, logTerm |-> 2, forced |-> FALSE, from |-> 1, count |-> 1], [term |-> 3, index |-> 2, type |-> "MsgPreVote", to |-> 3, logTerm |-> 2, forced |-> FALSE, from |-> 1, count |-> 1]}, afterRole |-> "PreCandidate", afterTerm |-> 2, fatal |-> ""]
AckGood == [before |-> <<[kind |-> "Normal", term |-> 2, index |-> 1, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 2, changes |-> <<>>, transition |-> "Legacy", weight |-> 1, encoded |-> 9, target |-> 0, id |-> 0]>>, after |-> <<[kind |-> "Normal", term |-> 2, index |-> 1, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 2, changes |-> <<>>, transition |-> "Legacy", weight |-> 1, encoded |-> 9, target |-> 0, id |-> 0], [kind |-> "V2", term |-> 2, index |-> 3, changes |-> <<>>, transition |-> "Auto", weight |-> 2, encoded |-> 10, target |-> 0, id |-> 0]>>, oldSnap |-> 0, batchSnap |-> 0, afterSnap |-> 0, cursor |-> 2, applied |-> 2, oldApplied |-> 1, config |-> [voters |-> {1, 2}, outgoing |-> {1, 2, 3}, learners |-> {}, learnersNext |-> {}, autoLeave |-> TRUE], role |-> "Leader", term |-> 2, pendingBefore |-> 2, pendingAfter |-> 2, quotaBefore |-> 0, quotaAfter |-> 1, committedWeight |-> 1, fatal |-> "", decision |-> "", raw |-> TRUE, outBefore |-> <<>>, outAfter |-> <<>>, readsBefore |-> <<>>, readsAfter |-> <<>>, ssBefore |-> [lead |-> 1, role |-> "Leader"], ssAfter |-> [lead |-> 1, role |-> "Leader"], batchReads |-> <<>>, hsBefore |-> [term |-> 2, commit |-> 2, vote |-> 0], hsAfter |-> [term |-> 2, commit |-> 2, vote |-> 0], batchHS |-> [term |-> 2, commit |-> 2, vote |-> 0]]
AckBadExtra == [AckGood EXCEPT !.after=Append(@,Entry(2,Len(@)+1,"Normal",0,0,0,8))]
AckBadLeave == [AckGood EXCEPT !.after[Len(AckGood.after)].transition="JointExplicit"]
AckWrongCursor == [AckGood EXCEPT !.applied=@+1]
AckWrongSnap == [AckGood EXCEPT !.oldSnap=9,!.batchSnap=3,!.afterSnap=0]
AckOutstanding == [before |-> <<[kind |-> "Normal", term |-> 2, index |-> 1, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 2, changes |-> <<>>, transition |-> "Legacy", weight |-> 1, encoded |-> 9, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 3, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "V2", term |-> 2, index |-> 4, changes |-> <<>>, transition |-> "Auto", weight |-> 2, encoded |-> 10, target |-> 0, id |-> 0]>>, after |-> <<[kind |-> "Normal", term |-> 2, index |-> 1, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 2, changes |-> <<>>, transition |-> "Legacy", weight |-> 1, encoded |-> 9, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 3, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "V2", term |-> 2, index |-> 4, changes |-> <<>>, transition |-> "Auto", weight |-> 2, encoded |-> 10, target |-> 0, id |-> 0], [kind |-> "V2", term |-> 2, index |-> 5, changes |-> <<>>, transition |-> "Auto", weight |-> 2, encoded |-> 10, target |-> 0, id |-> 0]>>, oldSnap |-> 0, batchSnap |-> 0, afterSnap |-> 0, cursor |-> 3, applied |-> 3, oldApplied |-> 2, config |-> [voters |-> {1, 2}, outgoing |-> {1, 2, 3}, learners |-> {}, learnersNext |-> {}, autoLeave |-> TRUE], role |-> "Leader", term |-> 2, pendingBefore |-> 2, pendingAfter |-> 2, quotaBefore |-> 0, quotaAfter |-> 2, committedWeight |-> 0, fatal |-> "", decision |-> "", raw |-> TRUE, outBefore |-> <<>>, outAfter |-> <<>>, readsBefore |-> <<>>, readsAfter |-> <<>>, ssBefore |-> [lead |-> 1, role |-> "Leader"], ssAfter |-> [lead |-> 1, role |-> "Leader"], batchReads |-> <<>>, hsBefore |-> [term |-> 2, commit |-> 3, vote |-> 0], hsAfter |-> [term |-> 2, commit |-> 3, vote |-> 0], batchHS |-> [term |-> 2, commit |-> 3, vote |-> 0]]
AutoZero == [before |-> <<[kind |-> "Normal", term |-> 2, index |-> 1, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 2, changes |-> <<>>, transition |-> "Legacy", weight |-> 1, encoded |-> 9, target |-> 0, id |-> 0]>>, after |-> <<[kind |-> "Normal", term |-> 2, index |-> 1, changes |-> <<>>, transition |-> "Legacy", weight |-> 0, encoded |-> 8, target |-> 0, id |-> 0], [kind |-> "Normal", term |-> 2, index |-> 2, changes |-> <<>>, transition |-> "Legacy", weight |-> 1, encoded |-> 9, target |-> 0, id |-> 0]>>, oldSnap |-> 0, batchSnap |-> 0, afterSnap |-> 0, cursor |-> 0, applied |-> 2, oldApplied |-> 2, config |-> [voters |-> {1, 2}, outgoing |-> {1, 2, 3}, learners |-> {}, learnersNext |-> {}, autoLeave |-> TRUE], role |-> "Leader", term |-> 2, pendingBefore |-> 0, pendingAfter |-> 0, quotaBefore |-> 0, quotaAfter |-> 0, committedWeight |-> 0, fatal |-> "", decision |-> "", raw |-> TRUE, outBefore |-> <<>>, outAfter |-> <<>>, readsBefore |-> <<>>, readsAfter |-> <<>>, ssBefore |-> [lead |-> 1, role |-> "Leader"], ssAfter |-> [lead |-> 1, role |-> "Leader"], batchReads |-> <<>>, hsBefore |-> [term |-> 2, commit |-> 2, vote |-> 0], hsAfter |-> [term |-> 2, commit |-> 2, vote |-> 0], batchHS |-> [term |-> 2, commit |-> 2, vote |-> 0]]
Rows == <<
[id |-> "successful-leave-may-update-pending",old |-> AutoOld([AckGood EXCEPT !.pendingAfter=Len(AckGood.after)]),candidate |-> CheckedAck([AckGood EXCEPT !.pendingAfter=Len(AckGood.after)]),expectedOld |-> TRUE,expectedCandidate |-> TRUE,kind |-> "allowed-control",observation |-> [AckGood EXCEPT !.pendingAfter=Len(AckGood.after)]],
[id |-> "joint-union-majority",old |-> (FlatTruth(QC)),candidate |-> (JointTruth(QC)),expectedOld |-> TRUE,expectedCandidate |-> FALSE,kind |-> "semantic-witness",observation |-> QC],
[id |-> "joint-both-majorities",old |-> (FlatTruth([QC EXCEPT !.matches={1,2,3}])),candidate |-> (JointTruth([QC EXCEPT !.matches={1,2,3}])),expectedOld |-> TRUE,expectedCandidate |-> TRUE,kind |-> "allowed-control",observation |-> "see source"],
[id |-> "nonvoter-contribution",old |-> (FlatTruth([QC EXCEPT !.matches={1,2,3,4}])),candidate |-> (JointTruth([QC EXCEPT !.matches={1,2,3,4}])),expectedOld |-> FALSE,expectedCandidate |-> FALSE,kind |-> "mutation-negative",observation |-> "see source"],
[id |-> "leave-id-zero-wrong-predecessor",old |-> (ConfigOld(BadLeaveCommit)),candidate |-> (ConfigTruth(BadLeaveCommit)),expectedOld |-> TRUE,expectedCandidate |-> FALSE,kind |-> "semantic-witness",observation |-> BadLeaveCommit],
[id |-> "leave-joint-predecessor",old |-> (ConfigOld(GoodLeaveCommit)),candidate |-> (ConfigTruth(GoodLeaveCommit)),expectedOld |-> TRUE,expectedCandidate |-> TRUE,kind |-> "allowed-control",observation |-> GoodLeaveCommit],
[id |-> "actual-bootstrap-exemption",old |-> (ConfigOld(BootCommit)),candidate |-> (ConfigTruth(BootCommit)),expectedOld |-> TRUE,expectedCandidate |-> TRUE,kind |-> "allowed-control",observation |-> BootCommit],
[id |-> "joint-self-quorum-False",old |-> (CampaignContract(C0)),candidate |-> (RevisedCampaignContract(C0)),expectedOld |-> FALSE,expectedCandidate |-> TRUE,kind |-> "semantic-witness",observation |-> C0],
[id |-> "joint-self-quorum-True",old |-> (CampaignContract(C1)),candidate |-> (RevisedCampaignContract(C1)),expectedOld |-> FALSE,expectedCandidate |-> TRUE,kind |-> "semantic-witness",observation |-> C1],
[id |-> "pending-v2-retained-obligation-False",old |-> (CampaignContract(C2)),candidate |-> (RevisedCampaignContract(C2)),expectedOld |-> FALSE,expectedCandidate |-> FALSE,kind |-> "retained-negative",observation |-> C2],
[id |-> "pending-v2-retained-obligation-True",old |-> (CampaignContract(C3)),candidate |-> (RevisedCampaignContract(C3)),expectedOld |-> FALSE,expectedCandidate |-> FALSE,kind |-> "retained-negative",observation |-> C3],
[id |-> "valid-auto-append",old |-> (Ack0(AckGood)),candidate |-> (CheckedAck(AckGood)),expectedOld |-> FALSE,expectedCandidate |-> TRUE,kind |-> "semantic-witness",observation |-> AckGood],
[id |-> "prefix-only-is-too-weak",old |-> (WeakPrefix(AckBadExtra)),candidate |-> (CheckedAck(AckBadExtra)),expectedOld |-> TRUE,expectedCandidate |-> FALSE,kind |-> "mutation-negative",observation |-> AckBadExtra],
[id |-> "empty-v2-is-not-necessarily-leave",old |-> (AckFrozen(AckBadLeave)),candidate |-> (CheckedAck(AckBadLeave)),expectedOld |-> TRUE,expectedCandidate |-> FALSE,kind |-> "mutation-negative",observation |-> AckBadLeave],
[id |-> "captured-cursor-retained",old |-> (Ack0(AckWrongCursor)),candidate |-> (CheckedAck(AckWrongCursor)),expectedOld |-> FALSE,expectedCandidate |-> FALSE,kind |-> "mutation-negative",observation |-> AckWrongCursor],
[id |-> "newer-snapshot-retained",old |-> (AckFrozen(AckWrongSnap)),candidate |-> (CheckedAck(AckWrongSnap)),expectedOld |-> FALSE,expectedCandidate |-> FALSE,kind |-> "mutation-negative",observation |-> AckWrongSnap],
[id |-> "outstanding-leave-not-duplicated",old |-> (AckFrozen(AckOutstanding)),candidate |-> (CheckedAck(AckOutstanding)),expectedOld |-> TRUE,expectedCandidate |-> FALSE,kind |-> "semantic-witness",observation |-> AckOutstanding],
[id |-> "positive-cursor-observer",old |-> (AutoOld(AutoZero)),candidate |-> (RevisedAutoLeaveContract(AutoZero)),expectedOld |-> FALSE,expectedCandidate |-> TRUE,kind |-> "observer-witness",observation |-> AutoZero]
>>

WitnessInit == /\ probe=0 /\ raft=EmptyFunction /\ disk=EmptyFunction /\ ready=EmptyFunction
 /\ application=EmptyFunction /\ requests=EmptyFunction /\ wire=EmptyBag /\ history=EmptyHistory /\ quality=EmptyQuality /\ audit=EmptyAudit
WitnessNext == probe'=probe /\ FALSE
WitnessCheck ==
 /\ \A t\in SeqSet(Rows):Assert(t.old=t.expectedOld /\ t.candidate=t.expectedCandidate,"unexpected " \o t.id \o " old=" \o ToString(t.old) \o " candidate=" \o ToString(t.candidate))
 /\ Assert(FlatPost.commit=2 /\ JointPost.commit=1 /\ JointEnough.commit=2,"actual original quorum transitions")
 /\ JsonSerialize("truth-table.json",[rows |-> Rows,nativeTransitions |-> [oldFlatCommit |-> FlatPost.commit,newJointCommit |-> JointPost.commit,newJointSufficient |-> JointEnough.commit]])
==============================
