diff --git a/confchange/restore.go b/confchange/restore.go
new file mode 100644
index 0000000..724068d
--- /dev/null
+++ b/confchange/restore.go
@@ -0,0 +1,155 @@
+// Copyright 2019 The etcd Authors
+//
