{
  "protocol": "action-validation/v1",
  "cwd": "/workspace",
  "implementation": {
    "command": [
      "python3",
      "/workspace/out/framework/adapters/go/run.py",
      "--input",
      "{input}",
      "--output",
      "{output}",
      "--work",
      "{work}"
    ],
    "timeout_seconds": 100
  },
  "model": {
    "command": [
      "python3",
      "/workspace/out/negative-controls/failing_adapter.py",
      "{output}"
    ],
    "generate_args": [
      "--generate"
    ],
    "timeout_seconds": 360
  },
  "unordered_paths": [
    "state.config.voters",
    "state.config.outgoing",
    "state.config.learners",
    "state.config.learnersNext",
    "state.prs",
    "state.messages",
    "state.votes",
    "state.readQueue.*.acks",
    "state.snapshot.config.voters",
    "state.snapshot.config.outgoing",
    "state.snapshot.config.learners",
    "state.snapshot.config.learnersNext",
    "state.storage.snapshot.config.voters",
    "state.storage.snapshot.config.outgoing",
    "state.storage.snapshot.config.learners",
    "state.storage.snapshot.config.learnersNext",
    "return.voters",
    "return.outgoing",
    "return.learners",
    "return.learnersNext",
    "return.messages",
    "return.snapshot.config.voters",
    "return.snapshot.config.outgoing",
    "return.snapshot.config.learners",
    "return.snapshot.config.learnersNext",
    "input.snapshot.config.voters",
    "input.snapshot.config.outgoing",
    "input.snapshot.config.learners",
    "input.snapshot.config.learnersNext",
    "state.messages.*.snapshot.config.voters",
    "state.messages.*.snapshot.config.outgoing",
    "state.messages.*.snapshot.config.learners",
    "state.messages.*.snapshot.config.learnersNext",
    "return.messages.*.snapshot.config.voters",
    "return.messages.*.snapshot.config.outgoing",
    "return.messages.*.snapshot.config.learners",
    "return.messages.*.snapshot.config.learnersNext"
  ]
}