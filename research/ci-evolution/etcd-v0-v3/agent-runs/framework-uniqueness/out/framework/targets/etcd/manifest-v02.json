{
  "protocol": "action-validation/v1",
  "cwd": ".",
  "implementation": {
    "command": [
      "python3",
      "out/framework/adapters/go/run.py",
      "--input",
      "{input}",
      "--output",
      "{output}",
      "--work",
      "{work}",
      "--source",
      "v02/source"
    ],
    "timeout_seconds": 100
  },
  "model": {
    "command": [
      "python3",
      "out/framework/adapters/tla/run.py",
      "--input",
      "{input}",
      "--output",
      "{output}",
      "--spec",
      "{spec}",
      "--work",
      "{work}"
    ],
    "generate_args": [
      "--generate"
    ],
    "timeout_seconds": 178
  },
  "unordered_paths": [
