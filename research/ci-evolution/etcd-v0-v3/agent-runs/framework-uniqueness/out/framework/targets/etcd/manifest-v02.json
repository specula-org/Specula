    "state.storage.snapshot.config.learnersNext",
    "return.voters",
    "return.outgoing",
    "return.learners",
    "return.learnersNext",
    "return.messages",
    "return.snapshot.config.voters",
    "return.snapshot.config.outgoing",
    "return.snapshot.config.learners",
    "return.snapshot.config.learnersNext",
    "input.snapshot.config.voters",
    "input.snapshot.config.outgoing",
    "input.snapshot.config.learners",
    "input.snapshot.config.learnersNext",
    "state.messages.*.snapshot.config.voters",
