    "input.batch.snapshot.config.learnersNext",
    "input.batch.messages.*.snapshot.config.voters",
    "input.batch.messages.*.snapshot.config.outgoing",
    "input.batch.messages.*.snapshot.config.learners",
    "input.batch.messages.*.snapshot.config.learnersNext",
    "return.batchAfter.messages",
    "return.batchAfter.snapshot.config.voters",
    "return.batchAfter.snapshot.config.outgoing",
    "return.batchAfter.snapshot.config.learners",
    "return.batchAfter.snapshot.config.learnersNext",
