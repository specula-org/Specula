{
  "protocol": "action-validation/v1",
  "version": "V02",
  "root": "Run from the supplied workspace root; all paths below are relative.",
  "tools": {
    "go": "/usr/local/go/bin/go",
    "tlc": "/tools/tla2tools.jar",
    "community_modules": "/tools/CommunityModules.jar",
    "python": "python3",
    "java": "/usr/bin/java"
  },
  "limits": {
    "tlc_timeout_seconds": 175,
    "tlc_workers": 1,
    "tlc_heap_gb": 2,
    "go_timeout_seconds": 90,
    "GOMAXPROCS": 2
  },
  "network": "disabled by GOPROXY=off/GOSUMDB=off; no downloads",
  "cache": "out/go-cache",
  "tmp": "out/tmp",
  "runs": [
    {
      "label": "baseline-code",
      "manifest": "out/framework/targets/etcd/manifest.json",
      "cases": "out/cases/code-inputs.json",
      "spec": "new/spec",
      "route": "code-to-model"
    },
    {
      "label": "baseline-model",
      "manifest": "out/framework/targets/etcd/manifest.json",
      "cases": "out/framework/targets/etcd/model-seeds.json",
      "spec": "new/spec",
      "route": "model-to-code"
    },
    {
      "label": "repaired-code",
      "manifest": "out/framework/targets/etcd/manifest.json",
      "cases": "out/cases/code-inputs.json",
      "spec": "out/repaired-spec",
      "route": "code-to-model"
    },
    {
      "label": "repaired-model",
      "manifest": "out/framework/targets/etcd/manifest.json",
      "cases": "out/framework/targets/etcd/model-seeds.json",
      "spec": "out/repaired-spec",
      "route": "model-to-code"
    },
    {
      "label": "old-version-subset",
      "manifest": "out/framework/targets/etcd/manifest-old.json",
      "cases": "out/cases/version-inputs.json",
      "spec": "old/spec",
      "route": "code-to-model"
    },
    {
      "label": "invalid-inputs",
      "manifest": "out/framework/targets/etcd/manifest.json",
      "cases": "out/cases/invalid-inputs.json",
      "spec": "out/repaired-spec",
      "route": "code-to-model"
    }
  ],
  "verification": [
    {
      "name": "generic-tests",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "out/framework",
        "-p",
        "test_runner.py",
        "-v"
      ],
      "cwd": ".",
      "timeout_seconds": 20,
      "expected_exit": 0
    },
    {
      "name": "valid-input-audit",
      "command": [
        "python3",
        "out/framework/targets/etcd/audit_inputs.py",
        "out/cases/code-inputs.json",
        "{output_root}/baseline-model/generated-cases.json"
      ],
      "cwd": ".",
      "timeout_seconds": 20,
      "expected_exit": 0
    },
    {
      "name": "invalid-input-audit",
      "command": [
        "python3",
        "out/framework/targets/etcd/audit_inputs.py",
        "out/cases/invalid-inputs.json"
      ],
      "cwd": ".",
      "timeout_seconds": 20,
      "expected_exit": 1
    },
    {
      "name": "source-tests",
      "command": [
        "timeout",
        "90s",
        "/usr/local/go/bin/go",
        "test",
        "-run",
        "Test(RawNodeConsumeReady|Learner.*|Restore.*|Node.*)$",
        "-count=1",
        ".",
        "./confchange",
        "./quorum",
        "./tracker",
        "./raftpb"
      ],
      "cwd": "new/source",
      "env": {
        "GOMAXPROCS": "2",
        "GOCACHE": "{root}/out/go-cache",
        "GOTMPDIR": "{root}/out/tmp",
        "TMPDIR": "{root}/out/tmp",
        "GOPROXY": "off",
        "GOSUMDB": "off",
        "GOFLAGS": "-mod=readonly",
        "GOTOOLCHAIN": "local",
        "CGO_ENABLED": "0"
      },
      "timeout_seconds": 95,
      "expected_exit": 0
    },
    {
      "name": "source-package-tests",
      "command": [
        "timeout",
        "90s",
        "/usr/local/go/bin/go",
        "test",
        "-count=1",
        "./confchange",
        "./quorum",
        "./tracker",
        "./raftpb"
      ],
      "cwd": "new/source",
      "env": {
        "GOMAXPROCS": "2",
        "GOCACHE": "{root}/out/go-cache",
        "GOTMPDIR": "{root}/out/tmp",
        "TMPDIR": "{root}/out/tmp",
        "GOPROXY": "off",
        "GOSUMDB": "off",
        "GOFLAGS": "-mod=readonly",
        "GOTOOLCHAIN": "local",
        "CGO_ENABLED": "0"
      },
      "timeout_seconds": 95,
      "expected_exit": 0
    }
  ],
  "regenerate_domains": [
    "python3",
    "out/framework/targets/etcd/domain_v02.py"
  ],
  "rerun": [
    "python3",
    "out/framework/targets/etcd/replay.py"
  ],
  "repair_patch": "out/adaptation/behavior-repairs.patch",
  "observer_patch_not_applied": "out/adaptation/observer-corrections.patch",
  "claim": "bounded local action validation; invalid-inputs is a separate negative domain; no safety or reachability proof",
  "report_command": [
    "python3",
    "out/framework/targets/etcd/summarize.py",
    "--run-root",
    "{output_root}"
  ]
}
