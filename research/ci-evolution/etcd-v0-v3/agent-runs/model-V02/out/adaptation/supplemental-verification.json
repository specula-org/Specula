{
  "generic-tests": {
    "log": "out/adaptation/runner-tests.log",
    "exit_code": 0,
    "manifest_command": {
      "name": "generic-tests",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "out/framework",
        "-p",
        "test_runner.py",
        "-v"
      ],
      "cwd": ".",
      "timeout_seconds": 20,
      "expected_exit": 0
    }
  },
  "valid-input-audit": {
    "log": "out/adaptation/valid-input-audit.json",
    "exit_code": 0,
    "manifest_command": {
      "name": "valid-input-audit",
      "command": [
        "python3",
        "out/framework/targets/etcd/audit_inputs.py",
        "out/cases/code-inputs.json",
        "{output_root}/baseline-model/generated-cases.json"
      ],
      "cwd": ".",
      "timeout_seconds": 20,
      "expected_exit": 0
    }
  },
  "invalid-input-audit": {
    "log": "out/adaptation/invalid-input-audit.json",
    "exit_code": 1,
    "manifest_command": {
      "name": "invalid-input-audit",
      "command": [
        "python3",
        "out/framework/targets/etcd/audit_inputs.py",
