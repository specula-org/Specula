  "source-tests": {
    "log": "out/adaptation/source-tests.log",
    "exit_code": 0,
    "tool_wall_seconds": 0.624943323,
    "manifest_command": {
      "name": "source-tests",
      "command": [
        "timeout",
        "90s",
        "/usr/local/go/bin/go",
        "test",
        "-run",
        "Test(RawNodeConsumeReady|Learner.*|Restore.*|Node.*)$",
        "-count=1",
        ".",
        "./confchange",
        "./quorum",
        "./tracker",
        "./raftpb"
      ],
      "cwd": "new/source",
      "env": {
        "GOMAXPROCS": "2",
        "GOCACHE": "{root}/out/go-cache",
        "GOTMPDIR": "{root}/out/tmp",
        "TMPDIR": "{root}/out/tmp",
        "GOPROXY": "off",
        "GOSUMDB": "off",
        "GOFLAGS": "-mod=readonly",
        "GOTOOLCHAIN": "local",
        "CGO_ENABLED": "0"
      },
      "timeout_seconds": 95,
      "expected_exit": 0
    }
  },
  "source-package-tests": {
    "log": "out/adaptation/source-package-tests.log",
    "exit_code": 0,
    "tool_wall_seconds": 0.312168371,
    "manifest_command": {
      "name": "source-package-tests",
      "command": [
        "timeout",
        "90s",
        "/usr/local/go/bin/go",
        "test",
        "-count=1",
        "./confchange",
        "./quorum",
        "./tracker",
        "./raftpb"
      ],
      "cwd": "new/source",
      "env": {
        "GOMAXPROCS": "2",
        "GOCACHE": "{root}/out/go-cache",
        "GOTMPDIR": "{root}/out/tmp",
        "TMPDIR": "{root}/out/tmp",
        "GOPROXY": "off",
        "GOSUMDB": "off",
        "GOFLAGS": "-mod=readonly",
        "GOTOOLCHAIN": "local",
        "CGO_ENABLED": "0"
      },
      "timeout_seconds": 95,
      "expected_exit": 0
    }
  }
