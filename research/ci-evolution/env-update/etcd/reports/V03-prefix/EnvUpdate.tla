------------------------------ MODULE EnvUpdate ------------------------------
EXTENDS Update
\* Generated by env-update/envupdate.py. Environment steps are the steps of the full model outside
\* the focused one; EnvUpdate keeps every update-view field none of them was seen to change.
EnvUpdate ==
    /\ history'["acks"] = history["acks"]
    /\ history'["autoLeaveChecks"] = history["autoLeaveChecks"]
    /\ history'["campaigns"] = history["campaigns"]
    /\ history'["commitUses"] = history["commitUses"]
    /\ history'["readyChecks"] = history["readyChecks"]
    /\ history'["recovery"] = history["recovery"]
    /\ history'["restoreChecks"] = history["restoreChecks"]
    /\ history'["wins"] = history["wins"]
    /\ \A n \in DOMAIN raft : raft'[n]["alive"] = raft[n]["alive"]
    /\ \A n \in DOMAIN raft : raft'[n]["applied"] = raft[n]["applied"]
    /\ \A n \in DOMAIN raft : raft'[n]["campaigns"] = raft[n]["campaigns"]
    /\ \A n \in DOMAIN raft : raft'[n]["cfgHist"] = raft[n]["cfgHist"]
    /\ \A n \in DOMAIN raft : raft'[n]["commitUses"] = raft[n]["commitUses"]
    /\ \A n \in DOMAIN raft : raft'[n]["config"] = raft[n]["config"]
    /\ \A n \in DOMAIN raft : raft'[n]["decision"] = raft[n]["decision"]
    /\ \A n \in DOMAIN raft : raft'[n]["elapsed"] = raft[n]["elapsed"]
    /\ \A n \in DOMAIN raft : raft'[n]["id"] = raft[n]["id"]
    /\ \A n \in DOMAIN raft : raft'[n]["lead"] = raft[n]["lead"]
    /\ \A n \in DOMAIN raft : raft'[n]["term"] = raft[n]["term"]
    /\ \A n \in DOMAIN raft : raft'[n]["vote"] = raft[n]["vote"]
    /\ \A n \in DOMAIN raft : raft'[n]["wins"] = raft[n]["wins"]
    /\ \A n \in DOMAIN raft : raft'[n]["yes"] = raft[n]["yes"]
EnvStep == FullUpdateNext /\ ~ConcreteUpdateNext
DischargeContext == [][EnvStep => EnvUpdate]_mcvars
